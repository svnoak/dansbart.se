# Beta/Staging Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dansbart_beta

# Authentication (DiscourseConnect — BFF pattern)
DISCOURSE_SSO_SECRET=
DISCOURSE_SSO_URL=
DISCOURSE_SSO_RETURN_URL=
SERVER_SECURE=true

# Redis (session storage + Celery broker)
REDIS_HOST=redis
REDIS_PORT=6379

# Spotify (optional)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Encrypts stored cloud storage tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Where the browser goes after a cloud storage consent. Empty means /mina-latar.
CONNECTIONS_SUCCESS_URL=

# Google Drive import: OAuth client from Google Cloud Console. The redirect URI is <site>/api/connections/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# HiDrive import: OAuth client from developer.hidrive.com. The redirect URI is <site>/api/connections/hidrive/callback.
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_REDIRECT_URI=
# The HiDrive endpoints. Empty means the production endpoints. The local profile points them at a stub.
HIDRIVE_AUTHORIZATION_URL=
HIDRIVE_TOKEN_URL=
